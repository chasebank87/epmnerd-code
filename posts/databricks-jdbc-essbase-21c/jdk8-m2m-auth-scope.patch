+  @Test
+  void setupM2MConfig_WithAuthScope_UsesProvidedScope() throws DatabricksSQLException {
+    setupM2MClientSecretMocks();
+    when(mockContext.getAuthScope()).thenReturn("sql");
+    configurator = new ClientConfigurator(mockContext);
+
+    DatabricksConfig config = configurator.getDatabricksConfig();
+    assertEquals(DatabricksJdbcConstants.M2M_AUTH_TYPE, config.getAuthType());
+    assertEquals(Collections.singletonList("sql"), config.getScopes());
+  }
+
+  @Test
+  void setupM2MConfig_WithoutAuthScope_UsesSdkDefaultScope() throws DatabricksSQLException {
+    setupM2MClientSecretMocks();
+    configurator = new ClientConfigurator(mockContext);
+
+    DatabricksConfig config = configurator.getDatabricksConfig();
+    assertEquals(DatabricksJdbcConstants.M2M_AUTH_TYPE, config.getAuthType());
+    assertEquals(Collections.singletonList("all-apis"), config.getScopes());
+  }
+
+  @Test
+  void setupM2MConfig_WithMultipleAuthScopes_UsesAllScopes() throws DatabricksSQLException {
+    setupM2MClientSecretMocks();
+    when(mockContext.getAuthScope()).thenReturn("sql offline_access");
+    configurator = new ClientConfigurator(mockContext);
+
+    DatabricksConfig config = configurator.getDatabricksConfig();
+    assertEquals(Arrays.asList("sql", "offline_access"), config.getScopes());
+  }
