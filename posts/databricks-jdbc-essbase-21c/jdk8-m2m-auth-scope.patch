+  /**
+   * Splits Auth_Scope on whitespace or commas; returns an empty list for null/blank. Java 8 safe.
+   */
+  public static List<String> parseOAuthScopes(String authScope) {
+    if (authScope == null || authScope.trim().isEmpty()) {
+      return Collections.emptyList();
+    }
+    List<String> out = new ArrayList<>();
+    for (String s : authScope.trim().split("[\\s,]+")) {
+      if (!s.isEmpty()) {
+        out.add(s);
+      }
+    }
+    return out;
+  }
